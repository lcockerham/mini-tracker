<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: `make install-sync-schedule` fills in __REPO__ and loads it into launchd. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.minitracker.minisgallery-sync</string>
    <key>WorkingDirectory</key>
    <string>__REPO__</string>
    <key>ProgramArguments</key>
    <array>
        <string>__REPO__/.venv/bin/python</string>
        <string>-m</string>
        <string>imports.minisgallery_sync</string>
    </array>
    <!-- 9am on the 1st of each month; launchd runs it on next wake if the Mac was asleep. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/mini-tracker-minisgallery-sync.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/mini-tracker-minisgallery-sync.log</string>
</dict>
</plist>
